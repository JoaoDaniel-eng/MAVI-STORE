{
  "name": "mavi",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "migrate": "npm run migrate -w apps/api --",
    "test": "node --import tsx --test \"packages/shared/test/*.test.ts\" \"apps/api/test/*.test.ts\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
